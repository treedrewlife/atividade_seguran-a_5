# Extensões da AC RAIZ (certificado autoassinado)
#
# basicConstraints: CA:TRUE diz "este certificado pode assinar outros certificados".
basicConstraints     = critical, CA:TRUE
# keyUsage: a chave da AC só serve para assinar certificados (keyCertSign)
# e listas de certificados revogados (cRLSign).
keyUsage             = critical, keyCertSign, cRLSign
# Identificador da própria chave pública (ajuda o software a montar a cadeia).
subjectKeyIdentifier = hash
